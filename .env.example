# Server-side AI keys (mapped into Vite client at build/dev time via vite.config.ts)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Provider routing: auto | gemini | anthropic | openai | selfhosted
AI_PROVIDER=auto

# Self-hosted (Ollama, OpenAI-compatible API) — souveraineté des données, pas de clé requise
SELF_HOSTED_BASE_URL=http://localhost:11434
SELF_HOSTED_MODEL=gemma3:1b

# Models
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Express API port (Vite proxies /api here — must match the running server)
API_PORT=3001

# Legacy alias; API_PORT takes precedence for the Express server
PORT=3001

# Supabase (à renseigner une fois le compte/projet créé — voir schéma proposé)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
